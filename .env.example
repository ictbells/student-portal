VITE_API_URL=

# Local (Vite): omit VITE_BASE (defaults to /student/)
#   npm run dev → http://localhost:5174/student/signup
#   API: php artisan serve --port=8000  (proxied by Vite)
#
# Local Apache pointing DocumentRoot at this folder's dist/ (or URL …/student/):
#   VITE_BASE=/student/   (default) or match the URL path to this app
#   VITE_API_URL=http://127.0.0.1:8000
#   npm run build
#
# Production CloudFront (student.cycbankease.com):
#   VITE_BASE=/
#   VITE_API_URL=https://bells-api.cycbankease.com
